{
  "dependencies": {
    "@netlify/functions": "^4.2.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "netlify-cli": "^23.1.4",
    "ts-jest": "^29.2.5"
  },
  "scripts": {
    "test": "jest",

    // install root + frontend deps in one go
    "setup": "npm install && cd FRONTEND && npm install",

    // run full stack (Netlify proxy + Vite frontend)
    "dev": "netlify dev",

    // convenience: build frontend for production
    "build": "npm run build --prefix FRONTEND"
  }
}
