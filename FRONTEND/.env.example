# ====== Spotify API credentials (required) ======
# You must create an app at https://developer.spotify.com/dashboard
# and copy your client ID + client secret here.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ====== Frontend OAuth config ======
# This must match the redirect URI set in your Spotify app dashboard.
VITE_REDIRECT_URI=http://localhost:8888/callback

# The Netlify serverless function that exchanges tokens.
VITE_TOKEN_ENDPOINT=/.netlify/functions/spotify-token

# ====== Frontend App Config ======
# Used by the React frontend when starting the login flow.
VITE_SPOTIFY_CLIENT_ID=${SPOTIFY_CLIENT_ID}
