{
	"info": {
		"_postman_id": "8756824b-1015-464d-be1e-af3efe1525c9",
		"name": "Spotify Playlist App",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "44160976"
	},
	"item": [
		{
			"name": "Get Current User (Me)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"200 OK\", () => pm.response.to.have.status(200));\r",
							"\r",
							"const me = pm.response.json();\r",
							"\r",
							"pm.environment.set(\"me_id\", me.id);\r",
							"pm.environment.set(\"me_name\", me.display_name || \"\");"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "https://api.spotify.com/v1/me",
					"protocol": "https",
					"host": [
						"api",
						"spotify",
						"com"
					],
					"path": [
						"v1",
						"me"
					]
				}
			},
			"response": []
		},
		{
			"name": "Search Tracks",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"200 OK\", () => pm.response.to.have.status(200));\r",
							"\r",
							"const body = pm.response.json();\r",
							"\r",
							"pm.test(\"tracks.items[] exists\", () => {\r",
							"    pm.expect(body).to.have.nested.property(\"tracks.items\");\r",
							"    pm.expect(body.tracks.items).to.be.an(\"array\");\r",
							"});\r",
							"\r",
							"\r",
							"// https://api.spotify.com/v1/search?type=track&limit=3&q=ACDC\r",
							"\r",
							"// Required query parameters:\r",
							"// q → your search string (e.g. hello)\r",
							"// type → what you want to search (track, artist, album, …).\r",
							"\r",
							"// Optional params:\r",
							"// limit → how many results to return (default 20, max 50).\r",
							"// offset → for pagination."
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "https://api.spotify.com/v1/search?type=track&limit=3&q=ACDC",
					"protocol": "https",
					"host": [
						"api",
						"spotify",
						"com"
					],
					"path": [
						"v1",
						"search"
					],
					"query": [
						{
							"key": "type",
							"value": "track"
						},
						{
							"key": "limit",
							"value": "3"
						},
						{
							"key": "q",
							"value": "ACDC"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Create Playlist",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"201 Created\", () => pm.response.to.have.status(201));\r",
							"\r",
							"const body = pm.response.json();\r",
							"\r",
							"pm.test(\"has id & name\", () => {\r",
							"\tpm.expect(body.id).to.be.a(\"string\").and.not.empty;\r",
							"});\r",
							"\r",
							"// stash for next calls\r",
							"pm.environment.set(\"playlist_id\", body.id);\r",
							"\r",
							"// URL: https://api.spotify.com/v1/users/{{me_id}}/playlists\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{ \"name\": \"Postman Test Playlist\", \"public\": false }",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "https://api.spotify.com/v1/users/{{me_id}}/playlists",
					"protocol": "https",
					"host": [
						"api",
						"spotify",
						"com"
					],
					"path": [
						"v1",
						"users",
						"{{me_id}}",
						"playlists"
					]
				}
			},
			"response": []
		},
		{
			"name": "Add track to playlist",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"201/200\", () => pm.expect([201, 200]).to.include(pm.response.code));\r",
							"\r",
							"const body = pm.response.json();\r",
							"\r",
							"pm.test(\"has snapshot_id\", () => {\r",
							"\tpm.expect(body.snapshot_id).to.be.a(\"string\").and.not.empty;\r",
							"});\r",
							"\r",
							"// optional: keep latest snapshot\r",
							"pm.environment.set(\"snapshot_id\", body.snapshot_id);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"uris\": [\"spotify:track:57bgtoPSgt236HzfBOd8kj\"]\r\n}\r\n\r\n// First search result from searching for 'ACDC'",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "https://api.spotify.com/v1/playlists/{{playlist_id}}/tracks",
					"protocol": "https",
					"host": [
						"api",
						"spotify",
						"com"
					],
					"path": [
						"v1",
						"playlists",
						"{{playlist_id}}",
						"tracks"
					]
				}
			},
			"response": []
		},
		{
			"name": "Delete playlist (Unfollow)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"200 or 204\", () => {\r",
							"\tpm.expect([200,204]).to.include(pm.response.code);\r",
							"});\r",
							"\r",
							"// Cleanup — clear playlist_id so we don’t accidentally reuse it\r",
							"pm.environment.unset(\"playlist_id\");\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "https://api.spotify.com/v1/playlists/{{playlist_id}}/followers",
					"protocol": "https",
					"host": [
						"api",
						"spotify",
						"com"
					],
					"path": [
						"v1",
						"playlists",
						"{{playlist_id}}",
						"followers"
					]
				}
			},
			"response": []
		}
	],
